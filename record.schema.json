{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardcycles.com/record.schema.json",
  "title": "The Cycle Record",
  "description": "Public contract for record.json and exact Cycle Record entry files. Past entries are never rewritten; a correction is a new entry and the earlier entry remains available.",
  "oneOf": [
    {
      "$ref": "#/$defs/recordList"
    },
    {
      "$ref": "#/$defs/entry"
    }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableDate": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "sealedItemA": {
      "type": "object",
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "const": "Sealed item A"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "additionalProperties": false
    },
    "sealedItemB": {
      "type": "object",
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "const": "Sealed item B"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "additionalProperties": false
    },
    "sealedItemC": {
      "type": "object",
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "const": "Sealed item C"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "additionalProperties": false
    },
    "privateSeal": {
      "type": "object",
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "const": "Private seal"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        }
      },
      "additionalProperties": false
    },
    "entryV1": {
      "type": "object",
      "required": [
        "corrects",
        "missed_weeks",
        "notes",
        "prev_chain_hash",
        "schema",
        "sealed_at",
        "sealed_items",
        "seq",
        "week_start"
      ],
      "properties": {
        "corrects": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "missed_weeks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "enum": [
              "CORRECTION",
              "GAP",
              "INSUFFICIENT_DATA"
            ]
          },
          "contains": {
            "const": "INSUFFICIENT_DATA"
          },
          "minContains": 1,
          "maxContains": 1,
          "uniqueItems": true
        },
        "prev_chain_hash": {
          "$ref": "#/$defs/hex64"
        },
        "schema": {
          "const": "cycle-record/1"
        },
        "sealed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "sealed_items": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/sealedItemA"
            },
            {
              "$ref": "#/$defs/sealedItemB"
            },
            {
              "$ref": "#/$defs/sealedItemC"
            },
            {
              "$ref": "#/$defs/privateSeal"
            }
          ],
          "items": false
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "week_start": {
          "$ref": "#/$defs/date"
        }
      },
      "additionalProperties": false
    },
    "futureVersionedEntry": {
      "description": "Prospective extension point. Publish the full new entry contract under a new schema file before emitting a future version.",
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "seq"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^cycle-record/(?:[2-9]|[1-9][0-9]+)$"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 2
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/entryV1"
        },
        {
          "$ref": "#/$defs/futureVersionedEntry"
        }
      ]
    },
    "openedItem": {
      "type": "object",
      "required": [
        "content",
        "salt"
      ],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": true
        },
        "salt": {
          "$ref": "#/$defs/hex64"
        }
      },
      "additionalProperties": false
    },
    "publicContextItem": {
      "type": "object",
      "required": [
        "item",
        "opened"
      ],
      "properties": {
        "item": {
          "enum": [
            "Sealed item A",
            "Sealed item B",
            "Sealed item C"
          ]
        },
        "opened": {
          "$ref": "#/$defs/openedItem"
        },
        "publication_status": {
          "enum": [
            "unpublished",
            "published"
          ]
        }
      },
      "additionalProperties": false
    },
    "publicContext": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(public_interest|release_rhythm|rarity_mix)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/publicContextItem"
      }
    },
    "timestampProof": {
      "type": "object",
      "required": [
        "completed_on",
        "entry_sha256",
        "file",
        "proof_sha256",
        "requested_on",
        "state",
        "verification",
        "verified_on"
      ],
      "properties": {
        "completed_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "entry_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "const": "entry.json.ots"
        },
        "proof_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "state": {
          "enum": [
            "none",
            "requested",
            "complete"
          ]
        },
        "verification": {
          "enum": [
            "not_verified",
            "verified"
          ]
        },
        "verified_on": {
          "$ref": "#/$defs/nullableDate"
        },
        "attested_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_reason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "openingEvent": {
      "type": "object",
      "required": [
        "entry_seq",
        "event_seq",
        "first_published_at",
        "item_label",
        "prior_event_fingerprint",
        "reveal_fingerprint",
        "schema"
      ],
      "properties": {
        "entry_seq": {
          "type": "integer",
          "minimum": 1
        },
        "event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "first_published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "item_label": {
          "enum": [
            "Sealed item A",
            "Sealed item B",
            "Sealed item C"
          ]
        },
        "prior_event_fingerprint": {
          "$ref": "#/$defs/hex64"
        },
        "reveal_fingerprint": {
          "$ref": "#/$defs/hex64"
        },
        "schema": {
          "const": "cycle-record-opening/1"
        }
      },
      "additionalProperties": false
    },
    "openingsMeta": {
      "type": "object",
      "required": [
        "count",
        "head_fingerprint",
        "schema"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "head_fingerprint": {
          "$ref": "#/$defs/hex64"
        },
        "schema": {
          "const": "cycle-record-opening-list/1"
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": [
        "chain_hash",
        "disclaimer",
        "entry",
        "entry_hash",
        "public_context",
        "schema",
        "seq",
        "timestamp_proof"
      ],
      "properties": {
        "chain_hash": {
          "$ref": "#/$defs/hex64"
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "$ref": "#/$defs/entry"
        },
        "entry_hash": {
          "$ref": "#/$defs/hex64"
        },
        "public_context": {
          "$ref": "#/$defs/publicContext"
        },
        "schema": {
          "const": "cycle-record-envelope/1"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp_proof": {
          "$ref": "#/$defs/timestampProof"
        },
        "study": {
          "$ref": "#/$defs/studies"
        }
      },
      "additionalProperties": false
    },
    "recordList": {
      "type": "object",
      "required": [
        "disclaimer",
        "entries",
        "generated_on",
        "note",
        "opening_events",
        "openings_meta",
        "schema"
      ],
      "properties": {
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/envelope"
          }
        },
        "generated_on": {
          "$ref": "#/$defs/date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "opening_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openingEvent"
          }
        },
        "openings_meta": {
          "$ref": "#/$defs/openingsMeta"
        },
        "schema": {
          "const": "cycle-record-list/1"
        },
        "study": {
          "$ref": "#/$defs/studies"
        },
        "instrument": {
          "$ref": "#/$defs/publicInstrument"
        }
      },
      "additionalProperties": false
    },
    "study": {
      "type": "object",
      "required": [
        "title",
        "units",
        "interval",
        "cutoff",
        "observation",
        "limitation",
        "evidence_status",
        "citation_url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "units": {
          "type": "string",
          "maxLength": 200
        },
        "interval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/date"
                },
                "end": {
                  "$ref": "#/$defs/date"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "cutoff": {
          "$ref": "#/$defs/nullableDate"
        },
        "observation": {
          "type": "string",
          "maxLength": 1000
        },
        "limitation": {
          "type": "string",
          "maxLength": 1000
        },
        "evidence_status": {
          "enum": [
            "sealed",
            "current context",
            "illustration"
          ]
        },
        "citation_url": {
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "studies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/study"
      }
    },
    "publicInstrument": {
      "type": "object",
      "description": "Unhashed current public context, separate from every exact sealed entry.",
      "required": [
        "schema",
        "methods",
        "attention",
        "printed_supply"
      ],
      "properties": {
        "schema": {
          "const": "cardcycles-instrument/1"
        },
        "methods": {
          "const": "/methods/"
        },
        "attention": {
          "type": "object",
          "required": [
            "source",
            "project",
            "article",
            "agent",
            "license",
            "months"
          ],
          "properties": {
            "source": {
              "const": "Wikimedia Foundation pageviews"
            },
            "project": {
              "const": "English Wikipedia"
            },
            "article": {
              "const": "Pokémon Trading Card Game"
            },
            "agent": {
              "const": "user"
            },
            "license": {
              "const": "CC0"
            },
            "months": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "month",
                  "days",
                  "views"
                ],
                "properties": {
                  "month": {
                    "type": "string",
                    "pattern": "[0-9]{4}-(?:0[1-9]|1[0-2])"
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "views": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "printed_supply": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "held until verified"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
